# Symlink handling (SomaOS Skill→Softill bridge)
.claude/skills/*/SKILL.md symlink=default

# Auto detect text files and ensure LF line endings
* text=auto

# Rust source
*.rs text diff=rust

# TypeScript/JavaScript
*.ts text diff=typescript
*.tsx text diff=typescript
*.js text diff=javascript
*.jsx text diff=javascript
*.json text diff=json

# Markdown
*.md text diff=markdown

# PowerShell scripts
*.ps1 text eol=crlf

# Shell scripts
*.sh text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf
