{
  "id": "combo-ai-pipeline",
  "version": "0.1.0",
  "goal": {
    "description": "AI 管线：收集上下文 → 加载 prompt → 调 LLM → 解析输出",
    "skillRefs": ["combo-design", "ai-integration"]
  },
  "context": {
    "allowedRead": [".claude/softills/"],
    "allowedWrite": [".claude/softills/"],
    "constraints": []
  },
  "plan": {
    "nodes": [
      {
        "id": "step-1-collect-context",
        "softill": "collect-context",
        "input": {
          "projectId": "__projectId__",
          "canvas": "__canvas__"
        },
        "when": { "always": true },
        "humanCheckpoint": false,
        "evidenceRequired": [],
        "description": "从 SQLite 读取画板数据"
      },
      {
        "id": "step-2-load-prompt",
        "softill": "load-prompt",
        "input": {
          "intent": "__intent__",
          "canvas": "__canvas__"
        },
        "when": { "step-1-collect-context": "PASS" },
        "humanCheckpoint": false,
        "evidenceRequired": [],
        "description": "加载 AI prompt 模板"
      },
      {
        "id": "step-3-llm-call",
        "softill": "llm-call",
        "input": {},
        "when": { "step-2-load-prompt": "PASS" },
        "humanCheckpoint": false,
        "evidenceRequired": [],
        "description": "调用 LLM 生成内容"
      },
      {
        "id": "step-4-parse-output",
        "softill": "parse-output",
        "input": {
          "schema": "__schema__"
        },
        "when": { "step-3-llm-call": "PASS" },
        "humanCheckpoint": false,
        "evidenceRequired": [],
        "description": "按 schema 解析 LLM 输出"
      }
    ],
    "validation": {
      "requiredEvidences": ["llm-call", "parse-output"],
      "minEvidenceCount": 2
    },
    "recovery": {
      "maxRetries": 2,
      "onMaxRetries": "human",
      "fallbackActions": [
        { "on": "step-3-llm-call:FAIL", "action": "retry", "description": "LLM 调用失败，重试" },
        { "on": "step-4-parse-output:FAIL", "action": "goto", "target": "step-3-llm-call", "description": "解析失败，重新生成" }
      ]
    }
  },
  "parameters": {
    "premise-variants": {
      "canvas": "premise",
      "intent": "generateVariants",
      "schema": "PremiseVariant[]"
    },
    "premise-reader-qa": {
      "canvas": "premise",
      "intent": "generateReaderQA",
      "schema": "ReaderQuestion[]"
    },
    "structure-generate": {
      "canvas": "structure",
      "intent": "generateStructure",
      "schema": "StructureNode[]"
    },
    "packet-generate": {
      "canvas": "packet",
      "intent": "generatePacket",
      "schema": "ChapterPacket"
    },
    "draft-generate": {
      "canvas": "text",
      "intent": "generateDraft",
      "schema": "string"
    }
  }
}
