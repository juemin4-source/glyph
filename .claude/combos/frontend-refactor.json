{
  "id": "combo-frontend-refactor",
  "version": "0.1.0",
  "goal": {
    "description": "前端组件化：发现重复 → 抽象组件 → 替换 → 清理",
    "skillRefs": ["frontend-refactor", "component-design"]
  },
  "plan": {
    "nodes": [
      {
        "id": "step-find-duplicates",
        "softill": "code-search",
        "input": { "pattern": "__PATTERN__" },
        "when": { "always": true },
        "description": "扫所有 feature canvas 找重复模式"
      },
      {
        "id": "step-extract-component",
        "softill": "file-patch",
        "input": {},
        "when": { "step-find-duplicates": "PASS" },
        "humanCheckpoint": true,
        "description": "提取共用组件到 components/ 目录"
      },
      {
        "id": "step-replace",
        "softill": "file-patch",
        "input": {},
        "when": { "step-extract-component": "PASS" },
        "description": "替换各 canvas 的实现为共用组件"
      },
      {
        "id": "step-verify",
        "softill": "test-runner",
        "input": { "command": "npx tsc -b" },
        "when": { "step-replace": "PASS" },
        "description": "验证构建通过"
      }
    ],
    "validation": { "requiredEvidences": ["test-runner"], "minEvidenceCount": 1 },
    "recovery": { "maxRetries": 1, "onMaxRetries": "human", "fallbackActions": [] }
  }
}
