      { "id": "step-cs26", "softill": "craft-skill", "input": { "skillId": "CS-26" }, "when": { "step-cs25": "PASS" }, "description": "物色诊断 — 赋予物品叙事重量" },
      { "id": "step-cs27", "softill": "craft-skill", "input": { "skillId": "CS-27" }, "when": { "step-cs26": "PASS" }, "description": "身位诊断 — 布置视点在场" },
      { "id": "step-cs28", "softill": "craft-skill", "input": { "skillId": "CS-28" }, "when": { "step-cs27": "PASS" }, "description": "声口诊断 — 设计对话功能" },
      { "id": "step-cs29", "softill": "craft-skill", "input": { "skillId": "CS-29" }, "when": { "step-cs28": "PASS" }, "description": "章句诊断 — 控制句子节奏" },
