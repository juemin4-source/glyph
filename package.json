    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16",
    "jsdom": "^25.0.1",
    "typescript": "~5.7",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3.2.7"
